# ============================================================================
# Mad Monkey Media — Environment Variables (.env.local)
# Copy this file to `.env.local` and fill in your actual credentials.
# Never commit `.env.local` or expose secret keys in client-side code.
# ============================================================================

# 1. Supabase Database Configuration (Table: `project_enquiries`)
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 2. Resend Email Notification Configuration
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Target inbox that receives new project enquiry notifications
CONTACT_RECEIVER_EMAIL=contact@themadmonkey.in

# Verified sender address in Resend (use onboarding@resend.dev for initial testing,
# or notifications@themadmonkey.in once themadmonkey.in is verified in Resend)
CONTACT_SENDER_EMAIL=onboarding@resend.dev
